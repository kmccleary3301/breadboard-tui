{
  "type": "module",
  "name": "@breadboard/harness",
  "version": "0.1.0",
  "private": true,
  "description": "BreadBoard native harness data snapshot and manifest helpers",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "check": "oxlint . && oxfmt --check --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,bench,examples,scripts}/**/*.ts' '*.ts' && bun run check:types",
    "check:types": "tsgo -p tsconfig.json --noEmit",
    "test": "bun test --parallel"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@oh-my-pi/pi-agent-core": "catalog:",
    "@oh-my-pi/pi-coding-agent": "catalog:",
    "@types/bun": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "files": [
    "src",
    "engine-data",
    "harnesses",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  }
}
