        "docs_tmp/bb_direction_assessment/evidence/ACI/**"
      ]
    },
    {
      "id": "manual-review-boundaries",
      "class": "manual-review",
      "description": "Package, lockfile, license/notice, Docker, and executable entrypoint boundaries require an owner and ordered layer.",
      "patterns": [
        "package.json",
        "**/package.json",
        "bun.lock",
        "**/bun.lock",
        "package-lock.json",
        "**/package-lock.json",
        "npm-shrinkwrap.json",
        "**/npm-shrinkwrap.json",
        "pnpm-lock.yaml",
        "**/pnpm-lock.yaml",
        "yarn.lock",
        "**/yarn.lock",
        "Cargo.lock",
        "**/Cargo.lock",
        "Dockerfile",
        "Dockerfile.*",
        "**/Dockerfile",
        "**/Dockerfile.*",
        "LICENSE",
        "LICENSE.*",
        "**/LICENSE",
        "**/LICENSE.*",
        "**/*license*",
        "**/*LICENSE*",
        "packages/*/src/cli.ts",
        "packages/*/src/cli/**",
        "packages/*/src/cli-commands.ts",
        "packages/*/src/commands/launch.ts",
        "packages/*/src/main.ts",
        "packages/*/src/index.ts",
        "packages/*/bin/**",
        "bin/**",
        "entrypoint",
        "entrypoint.*",
        "**/entrypoint",
        "**/entrypoint.*"
      ]
    },
    {
      "id": "generated-artifacts",
      "class": "generated",
      "description": "Generated trees, manifests, notices, and build outputs are reported separately from source ownership.",
      "patterns": [
        "generated/**",
        "**/generated/**",
        "**/*.generated.*",
        "**/*.gen.*",
        "**/*.manifest.json",
        "packages/coding-agent/THIRD_PARTY_NOTICES.txt",
        "packages/coding-agent/THIRD_PARTY_NOTICES.manifest.json",
        "docs/conformance/**",
        "docs_tmp/**",
        "**/*.tsv",
        "dist/**",
        "**/dist/**",
        "build/**",
        "**/build/**",
        "**/build.*",
        "**/*-build.*",
        "coverage/**",
        "**/coverage/**",
        ".tmp/**",
        "**/.tmp/**",
        "**/*.snap",
        "artifacts/fork-delta-audit.*"
      ]
    },
    {
      "id": "upstream-ordinary-omp",
      "class": "upstream-owned",
      "description": "Ordinary OMP package, crate, Python, and script paths remain upstream-authoritative.",
      "patterns": [
        "packages/*/CHANGELOG.md",
        "packages/*/src/**",
        "packages/*/test/**",
        "packages/*/tests/**",
        "packages/*/bench/**",
        "packages/*/examples/**",
        "packages/*/scripts/**",
        "crates/**",
        "python/**",
        "scripts/**/*.ts",
        ".github/workflows/**"
      ]
    }
  ],
  "manualBoundaries": [
    {
      "id": "release-boundary",
      "owner": "fork-release",
      "layer": 1,
      "patterns": [
        "package.json",
        "**/package.json",
        "bun.lock",
        "**/bun.lock",
        "package-lock.json",
        "**/package-lock.json",
        "npm-shrinkwrap.json",
        "**/npm-shrinkwrap.json",
        "pnpm-lock.yaml",
        "**/pnpm-lock.yaml",
        "yarn.lock",
        "**/yarn.lock",
        "Cargo.lock",
        "**/Cargo.lock",
        "Dockerfile",
        "Dockerfile.*",
        "**/Dockerfile",
        "**/Dockerfile.*",
        "LICENSE",
        "LICENSE.*",
        "**/LICENSE",
        "**/LICENSE.*",
        "**/*license*",
        "**/*LICENSE*",
        "NOTICE",
        "NOTICE.*",
        "**/NOTICE",
        "**/NOTICE.*",
        "**/*notice*",
        "**/*NOTICE*"
      ]
    },
    {
      "id": "entrypoint-boundary",
      "owner": "omp-entrypoint",
      "layer": 2,
      "patterns": [
        "packages/*/src/cli.ts",
        "packages/*/src/cli/**",
        "packages/*/src/cli-commands.ts",
        "packages/*/src/commands/launch.ts",
        "packages/*/src/main.ts",
        "packages/*/src/index.ts",
        "packages/*/bin/**",
        "bin/**",
        "entrypoint",
        "entrypoint.*",
        "**/entrypoint",
        "**/entrypoint.*"
      ]
    }
  ],
  "upstreamEntrypoints": [
    "packages/*/src/cli.ts",
    "packages/*/src/cli/**",
    "packages/*/src/cli-commands.ts",
    "packages/*/src/commands/launch.ts",
